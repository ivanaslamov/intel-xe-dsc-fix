--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -30,6 +30,7 @@
 #include <linux/iopoll.h>
 #include <linux/log2.h>
 #include <linux/math.h>
+#include <linux/moduleparam.h>
 #include <linux/notifier.h>
 #include <linux/seq_buf.h>
 #include <linux/slab.h>
@@ -819,6 +820,51 @@
 	return max_bpp;
 }
 
+/* Diagnostic only; all cases are restricted to BIG:1234 native mode.
+ * Default reproduces the previously tested eight 636x106 slices.
+ * Change only with the headset disabled, then perform a full modeset.
+ */
+static unsigned int beyond_dsc_test;
+module_param_named(beyond_dsc_test, beyond_dsc_test, uint, 0600);
+MODULE_PARM_DESC(beyond_dsc_test, "Beyond native DSC lab case 0..7 (experimental)");
+
+struct beyond_dsc_case {
+	u16 slices;
+	u16 height;
+	bool pre_scr;
+};
+
+static const struct beyond_dsc_case beyond_dsc_cases[] = {
+	{ 8, 106, false }, /* 0: reproduce test2 */
+	{ 8, 106, true  }, /* 1: legacy DSC 1.1 RC only */
+	{ 4, 106, false }, /* 2: reproduce test1 */
+	{ 4, 106, true  }, /* 3: legacy RC, four slices */
+	{ 4,  12, false }, /* 4: minimum-area four-slice geometry */
+	{ 4,  12, true  }, /* 5: minimum-area geometry, legacy RC */
+	{ 8,  24, false }, /* 6: minimum-area eight-slice geometry */
+	{ 8,  24, true  }, /* 7: minimum-area geometry, legacy RC */
+};
+
+static const struct beyond_dsc_case *
+intel_dp_beyond_dsc_case(const struct intel_connector *connector, int width)
+{
+	static const struct drm_edid_ident beyond = {
+		.panel_id = drm_edid_encode_panel_id('B', 'I', 'G', 0x1234),
+	};
+	unsigned int test = READ_ONCE(beyond_dsc_test);
+
+	if (connector->base.connector_type != DRM_MODE_CONNECTOR_DisplayPort ||
+	    connector->mst.dp || width != 5088 ||
+	    !drm_edid_match(connector->detect_edid, &beyond))
+		return NULL;
+
+	/* Invalid inputs preserve the default instead of indexing out of bounds. */
+	if (test >= ARRAY_SIZE(beyond_dsc_cases))
+		test = 0;
+
+	return &beyond_dsc_cases[test];
+}
+
 static int intel_dp_dsc_min_slice_count(const struct intel_connector *connector,
 					int mode_clock, int mode_hdisplay)
 {
@@ -889,6 +935,15 @@
 	/* Also take into account max slice width */
 	min_slice_count = max(min_slice_count,
 			      DIV_ROUND_UP(mode_hdisplay, max_slice_width));
+
+	/* Keep the regular sink/source throughput and slice-count checks. */
+	{
+		const struct beyond_dsc_case *test =
+			intel_dp_beyond_dsc_case(connector, mode_hdisplay);
+
+		if (test)
+			min_slice_count = max_t(int, min_slice_count, test->slices);
+	}
 
 	return min_slice_count;
 }
@@ -1872,6 +1927,14 @@
 
 	vdsc_cfg->slice_height = intel_dp_get_slice_height(vdsc_cfg->pic_height);
 
+	{
+		const struct beyond_dsc_case *test = intel_dp_beyond_dsc_case(
+			connector, crtc_state->hw.adjusted_mode.crtc_hdisplay);
+
+		if (test && vdsc_cfg->pic_height == 2544)
+			vdsc_cfg->slice_height = test->height;
+	}
+
 	ret = intel_dsc_compute_params(crtc_state);
 	if (ret)
 		return ret;
@@ -1898,6 +1961,30 @@
 	vdsc_cfg->block_pred_enable =
 		connector->dp.dsc_dpcd[DP_DSC_BLK_PREDICTION_SUPPORT - DP_DSC_SUPPORT] &
 		DP_DSC_BLK_PREDICTION_IS_SUPPORTED;
+
+	{
+		const struct beyond_dsc_case *test = intel_dp_beyond_dsc_case(
+			connector, crtc_state->hw.adjusted_mode.crtc_hdisplay);
+
+		if (test && vdsc_cfg->pic_height == 2544) {
+			if (test->pre_scr) {
+				/* Use the existing, validated legacy helper. Derive all
+				 * geometry-dependent values below before programming both
+				 * the encoder registers and the sink's PPS packet.
+				 */
+				ret = drm_dsc_setup_rc_params(vdsc_cfg, DRM_DSC_1_1_PRE_SCR);
+				if (ret)
+					return ret;
+				vdsc_cfg->initial_scale_value =
+					(vdsc_cfg->rc_model_size << 3) /
+					(vdsc_cfg->rc_model_size - vdsc_cfg->initial_offset);
+			}
+			drm_info(display->drm,
+				 "Beyond DSC lab: slices=%d height=%u legacy_rc=%d\n",
+				 intel_dsc_line_slice_count(&crtc_state->dsc.slice_config),
+				 vdsc_cfg->slice_height, test->pre_scr);
+		}
+	}
 
 	return drm_dsc_compute_rc_parameters(vdsc_cfg);
 }
