diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index e1e039f..9568c0e 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -6196,6 +6196,9 @@ intel_dp_update_420(struct intel_dp *intel_dp)
 static void
 intel_dp_set_edid(struct intel_dp *intel_dp)
 {
+	static const struct drm_edid_ident beyond_legacy = {
+		.panel_id = drm_edid_encode_panel_id('B', 'I', 'G', 0x5095),
+	};
 	struct intel_display *display = to_intel_display(intel_dp);
 	struct intel_connector *connector = intel_dp->attached_connector;
 	const struct drm_edid *drm_edid;
@@ -6208,6 +6211,16 @@ intel_dp_set_edid(struct intel_dp *intel_dp)
 	/* Below we depend on display info having been updated */
 	drm_edid_connector_update(&connector->base, drm_edid);
 
+	/* This Beyond EDID does not identify the display as a headset. */
+	if (!intel_dp_is_edp(intel_dp) && drm_edid_match(drm_edid, &beyond_legacy)) {
+		struct drm_connector *drm_connector = &connector->base;
+
+		drm_connector->display_info.non_desktop = true;
+		drm_object_property_set_value(&drm_connector->base,
+					      display->drm->mode_config.non_desktop_property,
+					      true);
+	}
+
 	vrr_capable = intel_vrr_is_capable(connector);
 	drm_dbg_kms(display->drm, "[CONNECTOR:%d:%s] VRR capable: %s\n",
 		    connector->base.base.id, connector->base.name, str_yes_no(vrr_capable));
